# Docmost deployment config - copy to .env on the server
# Change these values before deploying!

# Your domain or server IP
APP_URL=http://localhost:3000
PORT=3000

# Generate with: openssl rand -hex 32
APP_SECRET=eff6042e49ae40befe4be1f88d63e2a0d0514db279db64ed11f8d6fc6fda8359

JWT_TOKEN_EXPIRES_IN=30d

# Database
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql://docmost:CHANGE_ME_STRONG_PASSWORD@db:5432/docmost

REDIS_URL=redis://redis:6379

# Storage: local | s3 | azure
STORAGE_DRIVER=local

# SMTP (optional)
MAIL_DRIVER=smtp
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=Docmost
SMTP_HOST=127.0.0.1
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_IGNORETLS=false

# Optional: custom drawio server, Gotenberg for PDF export
DRAWIO_URL=
GOTENBERG_URL=

DISABLE_TELEMETRY=false